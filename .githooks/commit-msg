#!/bin/sh
# Rejects AI attribution and non-Conventional-Commit subjects.
# Enable once per clone: git config core.hooksPath .githooks

msg_file="$1"

# Strip comment lines (git's default commentChar).
body=$(grep -v '^#' "$msg_file")

if printf '%s\n' "$body" | grep -Eiq \
  'co-authored-by:.*(claude|anthropic|copilot|chatgpt|openai|gpt-|gemini)|noreply@anthropic\.com|generated (with|by) (an? )?\[?(claude|ai|chatgpt|copilot|gpt)\b|claude code|anthropic|🤖'; then
  echo "commit-msg: AI attribution is not allowed in commit messages (see CLAUDE.md §2)." >&2
  echo "Remove the Co-Authored-By / 'Generated with' lines and commit again." >&2
  exit 1
fi

subject=$(printf '%s\n' "$body" | sed -n '/[^[:space:]]/{p;q;}')

case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

if ! printf '%s\n' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: [^ ].*$'; then
  echo "commit-msg: subject must follow Conventional Commits, e.g. 'feat(api): add reservation endpoint'." >&2
  echo "Got: $subject" >&2
  exit 1
fi

if [ "${#subject}" -gt 100 ]; then
  echo "commit-msg: subject is longer than 100 characters." >&2
  exit 1
fi

exit 0
