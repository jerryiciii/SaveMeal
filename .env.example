# Copy to .env for local development. Never commit .env.
# These are local-only placeholders. Use real secrets only in the deployment environment.

# docker compose (Postgres)
POSTGRES_USER=savemeal
POSTGRES_PASSWORD=savemeal
POSTGRES_DB=savemeal
POSTGRES_PORT=5432

# Used by apps/api (Prisma). Each app also ships its own .env.example once scaffolded.
DATABASE_URL=postgresql://savemeal:savemeal@localhost:5432/savemeal?schema=public

# Feature flags: keep OFF for the pilot (see docs/ARCHITECTURE.md)
PAYMENTS_ENABLED=false
GOOGLE_LOGIN_ENABLED=false
