# Copy to apps/web/.env.local. Never commit real values.

# 1 (default) = in-browser mock API that follows docs/API_CONTRACT.md; 0 = proxy /api/v1 to the real API
NEXT_PUBLIC_API_MOCK=1

# Where the NestJS API listens when NEXT_PUBLIC_API_MOCK=0 (server-side rewrite target)
API_ORIGIN=http://localhost:4000
