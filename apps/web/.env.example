# Copy to apps/web/.env.local for local development. Never commit real secrets.
#
# Vercel Hobby (Free) deployment:
# - Set Root Directory to `apps/web` in Vercel Project Settings.
# - Demo mode (no backend required): set NEXT_PUBLIC_API_MOCK=1 (or omit it).
# - Production API mode: set NEXT_PUBLIC_API_MOCK=0 and set API_ORIGIN to your
#   NestJS API origin (no trailing slash). Next.js rewrites `/api/v1/*` to
#   `${API_ORIGIN}/api/v1/*` so the refresh cookie `lb_rt` stays first-party.
#   Uploaded images are resized/compressed client-side (<= 3.5 MB) to stay under
#   Vercel Hobby's 4.5 MB serverless/rewrite body limit.

# 1 (default) = in-browser mock API following docs/API_CONTRACT.md; 0 = proxy /api/v1 to real API
NEXT_PUBLIC_API_MOCK=1

# Server-side rewrite target for NestJS API when NEXT_PUBLIC_API_MOCK=0 (no trailing slash)
API_ORIGIN=http://localhost:4000
