# apps/api local configuration. Copy to apps/api/.env (git-ignored). Placeholders only: never
# commit real secrets. Real environment variables override this file.

NODE_ENV=development
PORT=4000
LOG_LEVEL=log

# Local PostgreSQL 16. `npm run db:start -w @savemeal/api` runs an embedded server with these
# credentials on :5432 (data in apps/api/.data/pg); `docker compose up -d db` works too.
DATABASE_URL=postgresql://savemeal:savemeal@localhost:5432/savemeal?schema=public
# e2e tests drop and re-create this database; its name must end in _test and it must be local.
TEST_DATABASE_URL=postgresql://savemeal:savemeal@localhost:5432/savemeal_test?schema=public

# Feature flags: keep OFF (CLAUDE.md §8). Both features are Later.
PAYMENTS_ENABLED=false
GOOGLE_LOGIN_ENABLED=false

# DOMAIN §11 defaults (all optional; shown with their default values).
MAX_ACTIVE_LISTINGS=5
MAX_WINDOW_HOURS=4
# Sanity limit from prepared time to pickup end, per category. Not a food-safety threshold.
MAX_LISTING_AGE_HOURS={"default":24,"PACKAGED":72}
MAX_QTY_PER_RESERVATION=2
MAX_ACTIVE_RESERVATIONS_PER_ACCOUNT=3
EARLY_PICKUP_MIN=30
NO_SHOW_GRACE_MIN=15
PICKUP_TOKEN_TTL_MIN=10
OTP_TTL_SEC=300
OTP_RESEND_SEC=60
OTP_MAX_ATTEMPTS=5
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# SYS-2 map settings (MapLibre + OpenStreetMap-based tiles).
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_ATTRIBUTION=© OpenStreetMap contributors

# Express trust proxy setting ('loopback' locally; set to '1' behind a cloud reverse proxy).
TRUST_PROXY=loopback

# Uploaded images (local disk for dev/pilot, or Supabase Storage in staging/prod).
MEDIA_STORAGE=local
# Local disk path relative to apps/api. Served at /api/v1/media/<key> when MEDIA_STORAGE=local.
UPLOAD_DIR=uploads

# Optional OTP email delivery for staging/production (`console` is forbidden in production).
# OTP_PROVIDER=resend
# OTP_EMAIL_FROM=no-reply@example.com
# OTP_EMAIL_FROM_NAME=SaveMeal
# RESEND_API_KEY=re_replace_me
# Or use Brevo:
# OTP_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-replace-me

# Optional Supabase Storage driver for staging/production (`MEDIA_STORAGE=supabase`).
# MEDIA_STORAGE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace_me
# SUPABASE_STORAGE_BUCKET=savemeal-media
# Optional public CDN/URL override (defaults to ${SUPABASE_URL}/storage/v1/object/public/${SUPABASE_STORAGE_BUCKET}):
# MEDIA_PUBLIC_BASE_URL=https://your-project.supabase.co/storage/v1/object/public/savemeal-media

# Optional bearer secret (>= 16 chars) for SYS-3 (`GET /api/v1/internal/cron/daily`, e.g. Vercel Cron).
# CRON_SECRET=replace_with_a_random_secret_at_least_16_chars
