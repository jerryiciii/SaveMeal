{
  "name": "@savemeal/api",
  "version": "1.0.0",
  "private": true,
  "description": "LASTBITE REST API (NestJS + Prisma + PostgreSQL), served under /api/v1.",
  "scripts": {
    "postinstall": "prisma generate",
    "build:shared": "npm run build -w @savemeal/shared",
    "prebuild": "npm run build:shared",
    "build": "tsc -p tsconfig.build.json",
    "predev": "npm run build:shared",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest",
    "test:e2e": "jest -c test/jest-e2e.config.js --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "db:start": "tsx scripts/db.mts start",
    "db:stop": "tsx scripts/db.mts stop",
    "db:status": "tsx scripts/db.mts status",
    "preprisma:seed": "npm run build:shared"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "~6.19.3",
    "@savemeal/shared": "*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "16.15.0-beta.19",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "pg": "^8.23.1",
    "prisma": "~6.19.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.15",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
